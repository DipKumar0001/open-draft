{
  "name": "open-draft",
  "version": "1.0.0",
  "description": "AI-powered agentic coding & document assistant. Claude Code-style CLI with Ollama support.",
  "bin": {
    "open-draft": "./dist/index.js",
    "docassist": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run postbuild",
    "postbuild": "mkdir -p dist/python && cp src/python/converter.py dist/python/converter.py",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.0.0",
    "cosmiconfig": "^9.0.0",
    "csv-parse": "^5.5.0",
    "docx": "^9.0.0",
    "figlet": "^1.11.0",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "mammoth": "^1.8.0",
    "marked": "^12.0.2",
    "marked-terminal": "^7.3.0",
    "officeparser": "^4.0.0",
    "openai": "^4.0.0",
    "ora": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "prompts": "^2.4.2",
    "sharp": "^0.33.0",
    "tesseract.js": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/fs-extra": "^11.0.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
